# 运行模式：demo 可单仓库预览；main-site 接入受信任的主站身份与数据网关。
LOTTERY_PROVIDER=main-site
LOTTERY_SITE_URL=http://localhost:5175
LOTTERY_CAMPAIGN_ID=community-lottery
LOTTERY_TIME_ZONE=Asia/Shanghai

# main-site provider 专用。demo 模式不读取这两项。
MAIN_SITE_URL=http://localhost:5173
LOTTERY_BACKEND_SECRET=replace-with-43-char-base64url-random-secret
# 只允许 prepare/draw；必须与普通数据网关密钥不同。
LOTTERY_ADMIN_BACKEND_SECRET=replace-with-a-different-43-char-random-secret
LOTTERY_SSO_AUDIENCE=open-lottery

# 本站会话。生产环境必须换成至少 32 个随机字节生成的值。
LOTTERY_SESSION_SECRET=replace-with-43-char-base64url-random-secret
LOTTERY_SESSION_TTL_SECONDS=604800

# 运营接口凭据与开奖私有种子。开放参与前固定，开奖后公开种子供复算。
LOTTERY_DRAW_SECRET=replace-with-43-char-base64url-random-secret
LOTTERY_DRAW_SEED=replace-with-43-char-base64url-random-seed

# 活动时间与数据库中的活动记录必须一致。demo provider 会直接读取这些值。
LOTTERY_CAMPAIGN_TITLE=Community Lottery
LOTTERY_CAMPAIGN_STARTS_AT=2030-07-01T00:00:00+08:00
LOTTERY_CAMPAIGN_CLOSES_AT=2030-07-31T20:00:00+08:00
LOTTERY_CAMPAIGN_DRAWS_AT=2030-07-31T20:00:00+08:00
LOTTERY_PRIZE_PLAN_JSON={"first":2,"second":2}

# 公开页面品牌和主视觉。
LOTTERY_BRAND_MARK=OL
LOTTERY_BRAND_NAME=Open Lottery
LOTTERY_BRAND_TAGLINE=COMMUNITY EVENT
LOTTERY_FOOTER_NOTICE=本活动由社区组织者发起，请以活动规则为准。
LOTTERY_HERO_KICKER=COMMUNITY × OPEN LOTTERY
LOTTERY_HERO_TITLE_LINE_ONE=Summer
LOTTERY_HERO_TITLE_LINE_TWO=Lottery
LOTTERY_HERO_YEAR_BADGE=30
LOTTERY_HERO_TITLE=社区抽奖活动
LOTTERY_HERO_DESCRIPTION=登录活动账号，领取一张属于你的活动票。
LOTTERY_ENTRY_PREFIX=LOT

# 奖品配置是 JSON 数组；imageUrl 可使用公开目录路径或完整 CDN URL。
LOTTERY_PRIZES_JSON=[{"tier":"first","rank":"01","title":"一等奖","description":"请填写一等奖内容与领取方式。","icon":"gift","imageUrl":"/prize-placeholder.svg"},{"tier":"second","rank":"02","title":"二等奖","description":"请填写二等奖内容与领取方式。","icon":"sparkles","imageUrl":""},{"tier":"participation","rank":"ALL","title":"参与纪念","description":"成功参与且未中前两档奖品的用户可获得参与纪念。","icon":"ticket","imageUrl":""}]

# 私密领奖联系方式。format 支持 text、email、qq。
LOTTERY_CONTACT_FORMAT=text
LOTTERY_CONTACT_LABEL=领奖联系方式
LOTTERY_CONTACT_PLACEHOLDER=请输入方便联系你的账号
LOTTERY_CONTACT_PRIVACY_NOTICE=联系方式只用于中奖后联系发奖，不会公开展示，也不会用于其他用途。
LOTTERY_NOTIFICATION_REQUIRED=false
LOTTERY_NOTIFICATION_LABEL=活动通知渠道
LOTTERY_NOTIFICATION_VALUE=
LOTTERY_NOTIFICATION_DESCRIPTION=活动结果公布后会通过配置的通知渠道提醒参与者。
LOTTERY_NOTIFICATION_CONFIRMATION_LABEL=我已加入活动通知渠道

# 参与前机器人验证。浏览器只配置 site key；secret 与 PoW 签名密钥属于 provider 后端。
VITE_AUTH_CAPTCHA_MODE=enforce
VITE_AUTH_CAPTCHA_PROVIDER=turnstile
VITE_AUTH_CAPTCHA_REQUIRED_ACTIONS=lottery_enter
VITE_AUTH_CAPTCHA_REGION_STRATEGY=cn-pow
VITE_TURNSTILE_SITE_KEY=
